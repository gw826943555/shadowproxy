START=90
STOP=15

USE_PROCD=1

# OpenWrt 内置的 jshn 库，用于在 generate_config_json() 中动态构建 JSON。
. /lib/functions.sh
. /usr/share/libubox/jshn.sh

NAME=shadowsocks-rust

RULES_DIR=/usr/share/$NAME/ss-rules
DOMAINS_RULES="$RULES_DIR/dnsmasq.uc"
NFT_RULES=/var/$NAME/shadowsocks-rust.nft
DNS_PORT=5300
ENABLED="$(uci -q get shadowsocks-rust.main.enabled)"

uci_load "$NAME"

_info() {
  logger -p 6 -t $NAME "$1"
}

_error() {
  logger -p 3 -t $NAME "$1"
}

parse_config_main() {
  section_name="$1"
  config_get redir_port "$section_name" redir_port
  config_get dns_port "$section_name" dns_port
  config_get dns_remote_addr "$section_name" dns_remote_addr
  config_get socks_port "$section_name" socks_port
  config_get http_port "$section_name" http_port

  if [ "$dns_port" != "$DNS_PORT" ]; then
    DNS_PORT=$dns_port
  fi

  # Expose values for jshn-based JSON generation in generate_config_json.
  MAIN_REDIR_PORT="$redir_port"
  MAIN_DNS_PORT="$dns_port"
  MAIN_DNS_REMOTE_ADDR="$dns_remote_addr"
  MAIN_SOCKS_PORT="$socks_port"
  MAIN_HTTP_PORT="$http_port"
}

# Global proxy behavior settings are stored in UCI section 'settings global'.
parse_config_global() {
  section_name="$1"
  config_get worker_count "$section_name" worker_count
  config_get client_cache_size "$section_name" client_cache_size
  config_get no_delay "$section_name" no_delay
  config_get keep_alive "$section_name" keep_alive
  config_get nofile "$section_name" nofile
  config_get fast_open "$section_name" fast_open
  config_get mptcp "$section_name" mptcp
  config_get log_level "$section_name" log_level
}

# parse_config_extra is kept for compatibility but holds no options itself.
parse_config_extra() {
  :
}

SERVER_LIST_STR=""

parse_config_node() {
  section_name="$1"
  local server
  local server_port
  local password
  local method
  local plugin
  local plugin_opts
  local enabled

  config_get server "$section_name" server
  config_get server_port "$section_name" server_port
  config_get password "$section_name" password
  config_get method "$section_name" method
  config_get plugin "$section_name" plugin
  config_get plugin_opts "$section_name" plugin_opts
  config_get enabled "$section_name" enabled

  # Only the simple-obfs client is supported for now.
  if [ -n "${plugin}" ] && [ "${plugin}" != "obfs-local" ]; then
    _error "unsupported plugin ${plugin}, only obfs-local is supported, ignoring it"
    plugin=""
    plugin_opts=""
  fi

  if [ "${enabled}" = '1' ]; then
    # A malformed server entry makes sslocal abort the whole instance, which
    # would take down every other server as well. Skip such entries.
    if [ -z "${server}" ] || [ -z "${method}" ]; then
      _error "node section ${section_name} misses server address or method, skipped"
      return
    fi
    if ! echo "${server_port}" | grep -qE '^[0-9]+$' ||
      [ "${server_port}" -lt 1 ] || [ "${server_port}" -gt 65535 ]; then
      _error "node section ${section_name} has an invalid port '${server_port}', skipped"
      return
    fi

    if [ -n "${plugin}" ]; then
      if ! command -v "${plugin}" >/dev/null 2>&1; then
        _error "plugin ${plugin} is not installed, node ${server} will not work"
      fi
    fi

    # Append this server to the JSON servers array via jshn.  The array must
    # already be open (see generate_config_json); jshn handles JSON escaping
    # of strings automatically, so no manual json_escape is needed here.
    json_add_object ""
    json_add_string "server" "$server"
    json_add_int "server_port" "$server_port"
    json_add_string "password" "$password"
    json_add_string "method" "$method"
    if [ -n "${plugin}" ]; then
      json_add_string "plugin" "$plugin"
      if [ -n "${plugin_opts}" ]; then
        json_add_string "plugin_opts" "$plugin_opts"
      fi
    fi
    json_close_object

    SERVER_LIST_STR="1"
  fi
}

generate_config_json() {
  # start_service may run more than once in the same process (reload_service
  # calls stop and then start), so rebuild the list from scratch.
  SERVER_LIST_STR=""

  # Build the config object with OpenWrt's built-in jshn library instead of
  # sed-replacing a static template.  jshn takes care of JSON string escaping
  # automatically (passwords, addresses, plugin opts, ...), so no template
  # file and no awk/sed splicing are needed anymore.

  parse_config_main main
  parse_config_global global

  # Sensible defaults when a UCI option is left unset.
  : "${MAIN_REDIR_PORT:=60080}"
  : "${MAIN_DNS_PORT:=5300}"
  : "${MAIN_SOCKS_PORT:=1080}"
  : "${MAIN_HTTP_PORT:=1081}"
  : "${MAIN_DNS_REMOTE_ADDR:=8.8.8.8}"
  : "${keep_alive:=30}"
  : "${nofile:=32768}"
  : "${client_cache_size:=0}"
  : "${worker_count:=1}"
  : "${no_delay:=1}"
  : "${fast_open:=1}"
  : "${mptcp:=1}"
  : "${log_level:=info}"

  json_init

  # ---- locals array ----
  json_add_array "locals"

  # socks5 local
  json_add_object ""
    if [ "${MAIN_SOCKS_PORT}" = "0" ]; then
      json_add_boolean "disabled" true
      json_add_int "local_port" 1080
    else
      json_add_boolean "disabled" false
      json_add_int "local_port" "${MAIN_SOCKS_PORT}"
    fi
    json_add_string "local_address" "::"
  json_close_object

  # http local
  json_add_object ""
    if [ "${MAIN_HTTP_PORT}" = "0" ]; then
      json_add_boolean "disabled" true
      json_add_int "local_port" 1081
    else
      json_add_boolean "disabled" false
      json_add_int "local_port" "${MAIN_HTTP_PORT}"
    fi
    json_add_string "local_address" "::"
    json_add_string "protocol" "http"
  json_close_object

  # redir local (tproxy)
  json_add_object ""
    json_add_string "local_address" "::"
    json_add_int "local_port" "${MAIN_REDIR_PORT}"
    json_add_string "protocol" "redir"
    json_add_string "tcp_redir" "tproxy"
    json_add_string "udp_redir" "tproxy"
    json_add_string "mode" "tcp_and_udp"
  json_close_object

  # dns local
  json_add_object ""
    json_add_string "local_address" "::"
    json_add_int "local_port" "${MAIN_DNS_PORT}"
    json_add_string "protocol" "dns"
    json_add_string "local_dns_address" "${MAIN_DNS_REMOTE_ADDR}"
    json_add_int "local_dns_port" 53
    json_add_string "remote_dns_address" "${MAIN_DNS_REMOTE_ADDR}"
    json_add_int "remote_dns_port" 53
    json_add_int "client_cache_size" "${client_cache_size}"
    # Need the TCP fallback: obfs-local (simple-obfs) is a TCP only plugin,
    # UDP relayed to the server as plain Shadowsocks datagrams often gets
    # dropped, which leaves every proxied DNS lookup unanswered.
    json_add_string "mode" "tcp_and_udp"
  json_close_object

  json_close_array

  # ---- servers array ----
  json_add_array "servers"
    config_foreach parse_config_node node
  json_close_array

  # ---- top-level fields ----
  json_add_int "timeout" 15
  json_add_int "keep_alive" "${keep_alive}"
  json_add_int "nofile" "${nofile}"
  json_add_boolean "ipv6_first" false
  json_add_boolean "ipv6_only" false
  json_add_int "outbound_fwmark" 255
  if [ "${no_delay}" = "0" ]; then
    json_add_boolean "no_delay" false
  else
    json_add_boolean "no_delay" true
  fi
  if [ "${fast_open}" = "0" ]; then
    json_add_boolean "fast_open" false
  else
    json_add_boolean "fast_open" true
  fi
  if [ "${mptcp}" = "0" ]; then
    json_add_boolean "mptcp" false
  else
    json_add_boolean "mptcp" true
  fi
  json_add_int "udp_timeout" 300
  json_add_int "udp_max_associations" 1024

  # balancer
  json_add_object "balancer"
    json_add_int "max_server_rtt" 15
    json_add_int "check_interval" 360
    json_add_int "check_best_interval" 120
  json_close_object

  # security
  json_add_object "security"
    json_add_object "replay_attack"
      json_add_string "policy" "reject"
    json_close_object
  json_close_object

  # log: sslocal takes the level as a number, 0 = info, 1 = debug, 2 = trace
  case "${log_level}" in
    debug) sslocal_log_level=1 ;;
    trace) sslocal_log_level=2 ;;
    *) sslocal_log_level=0 ;;
  esac
  json_add_object "log"
    json_add_int "level" "${sslocal_log_level}"
  json_close_object

  # runtime
  json_add_object "runtime"
    json_add_string "mode" "multi_thread"
    json_add_int "worker_count" "${worker_count}"
  json_close_object

  # 运行时生成的 config.json 放到 /var（tmpfs），避免频繁写 flash。
  mkdir -p /var/shadowsocks-rust
  json_dump > "/var/shadowsocks-rust/config.json"
}

config_route() {
  # Packets marked 100 by the ss-rules templates are routed to lo so that
  # they reach the tproxy rule in prerouting.
  for family in -4 -6; do
    while ip $family rule del fwmark 100 lookup 100 2>/dev/null; do true; done
    ip $family rule add fwmark 100 lookup 100 2>/dev/null || true
    ip $family route flush table 100 2>/dev/null || true
    ip $family route replace local default dev lo table 100 2>/dev/null || true
  done
}

update_nftables() {
  if [ -n "$(nft list tables | grep shadowsocks-rust-mangle)" ]; then
    nft delete table inet shadowsocks-rust-mangle
  fi

  # The ruleset is rendered from the ucode templates in $RULES_DIR. They read
  # the source/destination lists from UCI and the remote servers from config.json.
  if ! ucode -T "$RULES_DIR/rules.uc" > "$NFT_RULES"; then
    _error "failed to render nftables ruleset from $RULES_DIR"
    return 1
  fi
  if ! nft -f "$NFT_RULES"; then
    _error "failed to load nftables ruleset $NFT_RULES"
    return 1
  fi
}


start_shadowsocks_rust() {
  procd_open_instance shadowsocks-rust
  procd_set_param command /usr/bin/sslocal -c /var/shadowsocks-rust/config.json
  procd_set_param pidfile /var/run/shadowsocks-rust.pid
  procd_set_param file /var/shadowsocks-rust/config.json
  procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-2}
  procd_set_param limits core="unlimited"
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param limits nofile="20480 20480"
  procd_close_instance
}

# The domain list refresher runs as a second procd instance, so it is
# stopped with the service and restarted by procd if it dies. The first
# refresh happens right after start, then every refresh_hours hours.
start_domain_refresh() {
  local hours
  local interval

  config_get hours "settings" refresh_hours 24

  case "$hours" in
    ''|*[!0-9]*)
      hours=24
      ;;
  esac

  interval=$((hours * 3600))

  procd_open_instance domain-refresh
  procd_set_param command /usr/share/shadowsocks-rust/domain-refresh "$interval"
  procd_set_param stdout 1
  procd_set_param stderr 1
  # With interval 0 the helper refreshes once and exits, respawning it would
  # turn that into a busy loop.
  if [ "$interval" -gt 0 ] 2>/dev/null; then
    procd_set_param respawn 3600 5 5
  fi
  procd_close_instance
}

# The dnsmasq configuration itself is not touched: ss-rules/dnsmasq.uc writes
# a rules file into the dnsmasq conf-dir (tmpfs), so the upstream servers, the
# noresolv setting of the user and the flash are left alone. The helper
# reloads dnsmasq itself and only when the rules actually changed.

start_service() {
  _info "start shadowsocks-rust service."

  # 1. Check whether the service is enabled first, so that a disabled
  #    service does not touch the firewall or dnsmasq at all.
  if [ "${ENABLED}" != "1" ]; then
    _info "service shadowsocks-rust not enabled"
    return 0
  fi

  # 2. Generate config.json and make sure the servers array is not empty.
  if ! generate_config_json; then
    _error "failed to generate config.json"
    return 1
  fi

  if [ -z "${SERVER_LIST_STR}" ]; then
    _info "no enabled server, exit"
    return 1
  fi

  # 3. Start sslocal before installing the firewall rules, so that the
  #    tproxy port has a listener as soon as the rules take effect.
  start_shadowsocks_rust

  # 4. Transparent proxy rules (route table, nftables, dnsmasq) are optional.
  #    When disabled, only the local SOCKS5/HTTP proxy is started and the
  #    system network configuration is left untouched.
  local enable_rules
  config_get enable_rules "settings" enabled
  if [ "${enable_rules}" != "1" ]; then
    _info "transparent proxy rules disabled, local proxy only"
    return 0
  fi

  # 5. Install the routing rule and the nftables ruleset. Roll everything
  #    back when the ruleset cannot be loaded.
  config_route
  if ! update_nftables; then
    _error "failed to load nftables ruleset, rolling back"
    stop
    return 1
  fi

  # 6. Render the dnsmasq block from the local lists and the cached remote
  #    lists, then hand the download of the remote lists to a second procd
  #    instance. A slow or unreachable server never blocks the start, and
  #    procd stops the refresher together with the service.
  if [ -f "$DOMAINS_RULES" ]; then
    ucode "$DOMAINS_RULES" render || _error "failed to render the dnsmasq rules"
    start_domain_refresh
  else
    _error "dnsmasq rule script $DOMAINS_RULES is missing"
  fi
}

stop_service() {
  _info "stop shadowsocks-rust service."

  # Delete the nftables table first so that a background refresh finishing
  # right now skips writing the dnsmasq block back.
  if [ -n "$(nft list tables | grep shadowsocks-rust-mangle)" ]; then
    nft delete table inet shadowsocks-rust-mangle
  fi

  if [ -f "$DOMAINS_RULES" ]; then
    ucode "$DOMAINS_RULES" remove || _error "failed to remove the dnsmasq rules"
  fi

  # Clean up routing rules added by config_route()
  for family in -4 -6; do
    while ip $family rule del fwmark 100 lookup 100 2>/dev/null; do true; done
    ip $family route flush table 100 2>/dev/null || true
  done
}

service_triggers() {
  procd_add_reload_trigger "shadowsocks-rust"
}

reload_service() {
  stop
  start
}
