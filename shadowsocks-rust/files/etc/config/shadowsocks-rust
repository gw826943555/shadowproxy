config conf main
    option enabled '0'
    option socks_port '1080'
    option http_port '1081'
    option redir_port '60080'
    option dns_port '5300'
    option dns_remote_addr '1.1.1.1'

config settings global
    # 建议设为 CPU 核数。设得远高于核数只会增加线程栈和调度开销:
    # 64 个 worker 在 4 核路由器上会多占约 500MB 虚拟内存，吞吐并不会变高
    option worker_count '4'
    option client_cache_size '64'
    # TCP_NODELAY: 关掉 Nagle，小包不再被攒 40ms，改善视频分片请求和交互延迟
    option no_delay '1'
    option keep_alive 15
    option nofile '10240'
    option fast_open '0'
    option mptcp '0'
    # sslocal log level: info, debug or trace
    option log_level 'info'

config rules 'settings'
    # Apply the transparent proxy rules (route table, nftables, dnsmasq).
    # When disabled, sslocal only provides the local SOCKS5/HTTP proxy.
    option enabled '0'
    # accept: direct, checkdst: match the lists below, forward: always proxy
    option src_default 'accept'
    # accept: direct, forward: proxy
    option dst_default 'accept'
    # none: direct, checkdst: match the lists below, forward: always proxy
    option local_default 'none'
    # Redirect DNS queries from LAN clients to this router, so clients using
    # their own DNS server still go through the domain rules below.
    option dns_hijack '1'
    list proxy_ipset '8.8.8.8'
    # URLs of text files with one IP or CIDR per line, # starts a comment.
    #list proxy_ipset_url 'https://example.com/proxy-ips.txt'
    list proxy_domain 'google.com'
    # URLs of text files with one domain per line, downloaded on every start.
    #list proxy_domain_url 'https://example.com/proxy-domains.txt'
    # Hours between two downloads of the remote lists, 0 downloads them
    # only once when the service starts.
    option refresh_hours '24'
    list bypass_ipset '114.114.114.114'
    #list bypass_ipset_url 'https://example.com/bypass-ips.txt'
    list bypass_domain 'example.com'
    #list bypass_domain_url 'https://example.com/bypass-domains.txt'

config node
    option enabled '1'
    option server '45.32.222.22'
    option server_port '8388'
    option password 'barfoo!'
    option method 'rc4-md5'

config node
    option enabled '0'
    option server '2001:19f0:5001:46b:4:3:2:1'
    option server_port '8388'
    option password 'barfoo!'
    option method 'rc4-md5'
