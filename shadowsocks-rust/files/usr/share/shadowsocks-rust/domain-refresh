#!/bin/sh
#
# Keep the cached domain and IP lists up to date.
#
# Runs as the "domain-refresh" procd instance of the shadowsocks-rust
# service, so it is stopped together with the service and restarted by
# procd when it dies.
#
#   $1  seconds between two refreshes, 0 refreshes only once and exits.

RULES=/usr/share/shadowsocks-rust/ss-rules/dnsmasq.uc
INTERVAL="${1:-86400}"

case "$INTERVAL" in
  ''|*[!0-9]*)
    INTERVAL=86400
    ;;
esac

ucode "$RULES" refresh

[ "$INTERVAL" -gt 0 ] || exit 0

while :; do
  sleep "$INTERVAL"
  ucode "$RULES" refresh
done
