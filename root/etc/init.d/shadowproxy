START=90
STOP=15

USE_PROCD=1

# OpenWrt 内置的 jshn 库，用于在 generate_config_json() 中动态构建 JSON。
. /lib/functions.sh

NAME=shadowproxy

CONF_DIR=/etc/$NAME
SERVERS_TMP=/tmp/$NAME-servers.$$
DNSMASQ_CONF=/etc/dnsmasq.conf
DNSMASQ_CONF_BEGIN="# BEGIN shadowproxy"
DNSMASQ_CONF_END="# END shadowproxy"
TPROXY_PORT=60080
DNS_PORT=5300
SERVER_LIST_V4=""
SERVER_LIST_V6=""
ENABLED="$(uci -q get shadowproxy.main.enabled)"

uci_load "$NAME"

_info() {
  logger -p 6 -t $NAME "$1"
}

_error() {
  logger -p 3 -t $NAME "$1"
}

parse_config_main() {
  section_name="$1"
  config_get redir_port "$section_name" redir_port
  config_get dns_port "$section_name" dns_port
  config_get dns_remote_addr "$section_name" dns_remote_addr
  config_get socks_port "$section_name" socks_port
  config_get http_port "$section_name" http_port

  if [ "$redir_port" != "$TPROXY_PORT" ]; then
    TPROXY_PORT=$redir_port
  fi

  if [ "$dns_port" != "$DNS_PORT" ]; then
    DNS_PORT=$dns_port
  fi

  # Expose values for jshn-based JSON generation in generate_config_json.
  MAIN_REDIR_PORT="$redir_port"
  MAIN_DNS_PORT="$dns_port"
  MAIN_DNS_REMOTE_ADDR="$dns_remote_addr"
  MAIN_SOCKS_PORT="$socks_port"
  MAIN_HTTP_PORT="$http_port"
}

# Global proxy behavior settings are stored in UCI section 'settings global'.
parse_config_global() {
  section_name="$1"
  config_get worker_count "$section_name" worker_count
  config_get client_cache_size "$section_name" client_cache_size
  config_get no_delay "$section_name" no_delay
  config_get keep_alive "$section_name" keep_alive
  config_get nofile "$section_name" nofile
  config_get fast_open "$section_name" fast_open
  config_get mptcp "$section_name" mptcp
}

# parse_config_extra is kept for compatibility but holds no options itself.
parse_config_extra() {
  :
}

SERVER_LIST_STR=""

parse_config_node() {
  section_name="$1"
  local server
  local server_port
  local password
  local method
  local plugin
  local plugin_opts
  local enabled

  config_get server "$section_name" server
  config_get server_port "$section_name" server_port
  config_get password "$section_name" password
  config_get method "$section_name" method
  config_get plugin "$section_name" plugin
  config_get plugin_opts "$section_name" plugin_opts
  config_get enabled "$section_name" enabled

  # Only the simple-obfs client is supported for now.
  if [ -n "${plugin}" ] && [ "${plugin}" != "obfs-local" ]; then
    _error "unsupported plugin ${plugin}, only obfs-local is supported, ignoring it"
    plugin=""
    plugin_opts=""
  fi

  if [ "${enabled}" = '1' ]; then
    # A malformed server entry makes sslocal abort the whole instance, which
    # would take down every other server as well. Skip such entries.
    if [ -z "${server}" ] || [ -z "${method}" ]; then
      _error "node section ${section_name} misses server address or method, skipped"
      return
    fi
    if ! echo "${server_port}" | grep -qE '^[0-9]+$' ||
      [ "${server_port}" -lt 1 ] || [ "${server_port}" -gt 65535 ]; then
      _error "node section ${section_name} has an invalid port '${server_port}', skipped"
      return
    fi

    if [ "${server}" = "$(echo $server | grep -E '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')" ]; then
      SERVER_LIST_V4="$SERVER_LIST_V4 ${server},"
    elif [ "${server}" = "$(echo $server | grep -E '^([0-9a-fA-F]{0,4}:){1,7}[0-9a-fA-F]{1,4}$' )" ]; then
      SERVER_LIST_V6="$SERVER_LIST_V6 ${server},"
    else
      echo "Unrecognized IP format $server"
    fi

    if [ -n "${plugin}" ]; then
      if ! command -v "${plugin}" >/dev/null 2>&1; then
        _error "plugin ${plugin} is not installed, node ${server} will not work"
      fi
    fi

    # Append this server to the JSON servers array via jshn.  The array must
    # already be open (see generate_config_json); jshn handles JSON escaping
    # of strings automatically, so no manual json_escape is needed here.
    json_add_object ""
    json_add_string "server" "$server"
    json_add_int "server_port" "$server_port"
    json_add_string "password" "$password"
    json_add_string "method" "$method"
    if [ -n "${plugin}" ]; then
      json_add_string "plugin" "$plugin"
      if [ -n "${plugin_opts}" ]; then
        json_add_string "plugin_opts" "$plugin_opts"
      fi
    fi
    json_close_object

    SERVER_LIST_STR="1"
  fi
}

generate_config_json() {
  # start_service may run more than once in the same process (reload_service
  # calls stop and then start), so rebuild the lists from scratch.
  SERVER_LIST_STR=""
  SERVER_LIST_V4=""
  SERVER_LIST_V6=""

  # Build the config object with OpenWrt's built-in jshn library instead of
  # sed-replacing a static template.  jshn takes care of JSON string escaping
  # automatically (passwords, addresses, plugin opts, ...), so no template
  # file and no awk/sed splicing are needed anymore.

  parse_config_main main
  parse_config_global global

  # Sensible defaults when a UCI option is left unset.
  : "${MAIN_REDIR_PORT:=60080}"
  : "${MAIN_DNS_PORT:=5300}"
  : "${MAIN_SOCKS_PORT:=1080}"
  : "${MAIN_HTTP_PORT:=1081}"
  : "${MAIN_DNS_REMOTE_ADDR:=8.8.8.8}"
  : "${keep_alive:=30}"
  : "${nofile:=32768}"
  : "${client_cache_size:=0}"
  : "${worker_count:=1}"
  : "${no_delay:=1}"
  : "${fast_open:=1}"
  : "${mptcp:=1}"

  json_init

  # ---- locals array ----
  json_add_array "locals"

  # socks5 local
  json_add_object ""
    if [ "${MAIN_SOCKS_PORT}" = "0" ]; then
      json_add_boolean "disabled" true
      json_add_int "local_port" 1080
    else
      json_add_boolean "disabled" false
      json_add_int "local_port" "${MAIN_SOCKS_PORT}"
    fi
    json_add_string "local_address" "::"
  json_close_object

  # http local
  json_add_object ""
    if [ "${MAIN_HTTP_PORT}" = "0" ]; then
      json_add_boolean "disabled" true
      json_add_int "local_port" 1081
    else
      json_add_boolean "disabled" false
      json_add_int "local_port" "${MAIN_HTTP_PORT}"
    fi
    json_add_string "local_address" "::"
    json_add_string "protocol" "http"
  json_close_object

  # redir local (tproxy)
  json_add_object ""
    json_add_string "local_address" "::"
    json_add_int "local_port" "${MAIN_REDIR_PORT}"
    json_add_string "protocol" "redir"
    json_add_string "tcp_redir" "tproxy"
    json_add_string "udp_redir" "tproxy"
    json_add_string "mode" "tcp_and_udp"
    json_add_string "acl" "/etc/shadowproxy/shadowproxy-redir.acl"
  json_close_object

  # dns local
  json_add_object ""
    json_add_string "local_address" "::"
    json_add_int "local_port" "${MAIN_DNS_PORT}"
    json_add_string "protocol" "dns"
    json_add_string "local_dns_address" "${MAIN_DNS_REMOTE_ADDR}"
    json_add_int "local_dns_port" 53
    json_add_string "remote_dns_address" "${MAIN_DNS_REMOTE_ADDR}"
    json_add_int "remote_dns_port" 53
    json_add_int "client_cache_size" "${client_cache_size}"
    json_add_string "mode" "udp_only"
  json_close_object

  json_close_array

  # ---- servers array ----
  json_add_array "servers"
    config_foreach parse_config_node node
  json_close_array

  # ---- top-level fields ----
  json_add_int "timeout" 15
  json_add_int "keep_alive" "${keep_alive}"
  json_add_int "nofile" "${nofile}"
  json_add_boolean "ipv6_first" false
  json_add_boolean "ipv6_only" false
  json_add_int "outbound_fwmark" 255
  if [ "${no_delay}" = "0" ]; then
    json_add_boolean "no_delay" false
  else
    json_add_boolean "no_delay" true
  fi
  if [ "${fast_open}" = "0" ]; then
    json_add_boolean "fast_open" false
  else
    json_add_boolean "fast_open" true
  fi
  if [ "${mptcp}" = "0" ]; then
    json_add_boolean "mptcp" false
  else
    json_add_boolean "mptcp" true
  fi
  json_add_int "udp_timeout" 300
  json_add_int "udp_max_associations" 1024

  # balancer
  json_add_object "balancer"
    json_add_int "max_server_rtt" 15
    json_add_int "check_interval" 360
    json_add_int "check_best_interval" 120
  json_close_object

  # security
  json_add_object "security"
    json_add_object "replay_attack"
      json_add_string "policy" "reject"
    json_close_object
  json_close_object

  # log
  json_add_object "log"
    json_add_string "config_path" "/var/shadowproxy/log4rs.yml"
  json_close_object

  # runtime
  json_add_object "runtime"
    json_add_string "mode" "multi_thread"
    json_add_int "worker_count" "${worker_count}"
  json_close_object

  # 把运行时生成的 config.json 和 log4rs.yml 放到 /var（tmpfs），避免频繁写 flash。
  mkdir -p /var/shadowproxy
  if [ -f "$CONF_DIR/log4rs.yml" ]; then
    cp "$CONF_DIR/log4rs.yml" "/var/shadowproxy/log4rs.yml"
  fi
  json_dump_to_file "/var/shadowproxy/config.json"
}

config_sysctl() {
  sysctl -e -w net.bridge.bridge-nf-call-arptables=0 > /dev/null
  sysctl -e -w net.bridge.bridge-nf-call-iptables=0 > /dev/null
  sysctl -e -w net.bridge.bridge-nf-call-ip6tables=0 > /dev/null
}

config_route() {
  ip -4 rule del fwmark 0x1 table 803 || true
  ip -4 rule add fwmark 0x1 table 803
  ip -4 route del local 0.0.0.0/0 dev lo table 803 || true
  ip -4 route add local 0.0.0.0/0 dev lo table 803

  ip -6 rule del fwmark 0x1 table 803 || true
  ip -6 rule add fwmark 0x1 table 803
  ip -6 route del local ::/0 dev lo table 803 || true
  ip -6 route add local ::/0 dev lo table 803
}

update_nftables() {
  if [ -n "$(nft list tables | grep shadowproxy-mangle)" ]; then
    nft delete table inet shadowproxy-mangle
  fi
  nft -f /etc/shadowproxy/shadowproxy.nft -Dtproxy_port=${TPROXY_PORT}
  # read the bypass list from UCI 'config rules bypass_ipset'
  local bypass_ipsets
  config_get bypass_ipsets "settings" bypass_ipset
  for item in $bypass_ipsets; do
    if [ "${item}" = "$(echo $item | grep -E '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}')" ]; then
      SERVER_LIST_V4="$SERVER_LIST_V4 ${item},"
    elif [ "${item}" = "$(echo $item | grep -E '^([0-9a-fA-F]{0,4}:){1,7}[0-9a-fA-F]{1,4}$')" ]; then
      SERVER_LIST_V6="$SERVER_LIST_V6 ${item},"
    else
      echo "Unrecognized IP format $item"
    fi
  done

  if [ -n "${SERVER_LIST_V4}" ]; then
    nft add element inet shadowproxy-mangle whitelist_v4_set \{ "${SERVER_LIST_V4}" \}
  fi
  if [ -n "${SERVER_LIST_V6}" ]; then
    nft add element inet shadowproxy-mangle whitelist_v6_set \{ "${SERVER_LIST_V6}" \}
  fi

  # Add user-configured IPs/CIDRs that should always be proxied
  local proxy_ipsets
  config_get proxy_ipsets "settings" proxy_ipset
  for ip in $proxy_ipsets; do
    case "$ip" in
      *:*)
        nft add element inet shadowproxy-mangle proxy_set6 \{ "$ip" \} 2>/dev/null || true
        ;;
      *)
        nft add element inet shadowproxy-mangle proxy_set4 \{ "$ip" \} 2>/dev/null || true
        ;;
    esac
  done
}

update_dnsmasq_rules() {
  # Only the domains listed in the LuCI page are resolved by sslocal (through
  # the tunnel) and get proxied. dnsmasq keeps resolving everything else with
  # its own upstream and adds the addresses of the listed domains to the nft
  # sets, so the firewall only redirects the traffic of those domains.
  # Domains in bypass_domain are resolved directly, not through the tunnel.
  local domain
  local tmp
  local proxy_domains
  local bypass_domains
  local skip

  tmp=/tmp/$NAME-dnsmasq.$$
  : > "$tmp"

  config_get proxy_domains "settings" proxy_domain
  config_get bypass_domains "settings" bypass_domain
  for domain in $proxy_domains; do
    domain=$(printf '%s' "$domain" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -z "$domain" ] && continue
    case "$domain" in \#*) continue ;; esac
    # Skip domains in bypass_domain (resolved directly, not through tunnel)
    skip=0
    for bd in $bypass_domains; do
      bd=$(printf '%s' "$bd" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
      [ -z "$bd" ] && continue
      # Exact match or subdomain match (e.g. bypass example.com skips sub.example.com)
      if [ "$domain" = "$bd" ]; then
        skip=1
        break
      fi
      case ".$domain" in
        *".$bd") skip=1; break ;;
      esac
    done
    [ "$skip" -eq 1 ] && continue
    if ! printf '%s' "$domain" | grep -qE '^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+$'; then
      _error "invalid proxy domain '${domain}', skipped"
      continue
    fi
    echo "server=/${domain}/127.0.0.1#${DNS_PORT}" >> "$tmp"
    echo "nftset=/${domain}/4#inet#shadowproxy-mangle#proxy_set4,6#inet#shadowproxy-mangle#proxy_set6" >> "$tmp"
  done

  # Replace our own block in /etc/dnsmasq.conf, keep everything else intact
  [ -f "$DNSMASQ_CONF" ] &&
    sed -i "/^${DNSMASQ_CONF_BEGIN}\$/,/^${DNSMASQ_CONF_END}\$/d" "$DNSMASQ_CONF"
  {
    echo "$DNSMASQ_CONF_BEGIN"
    cat "$tmp"
    echo "$DNSMASQ_CONF_END"
  } >> "$DNSMASQ_CONF"
  rm -f "$tmp"
}

remove_dnsmasq_rules() {
  [ -f "$DNSMASQ_CONF" ] || return 0
  sed -i "/^${DNSMASQ_CONF_BEGIN}\$/,/^${DNSMASQ_CONF_END}\$/d" "$DNSMASQ_CONF"
}

start_shadowproxy() {
  procd_open_instance shadowproxy
  procd_set_param command /usr/bin/sslocal -c /var/shadowproxy/config.json
  procd_set_param pidfile /var/run/shadowproxy.pid
  procd_set_param file /var/shadowproxy/config.json
  procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-2}
  procd_set_param limits core="unlimited"
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param limits nofile="20480 20480"
  procd_close_instance
}

# The dnsmasq configuration itself is not touched, only our own block in
# /etc/dnsmasq.conf is (re)written, so the upstream servers and the noresolv
# setting of the user are left alone.
reload_dnsmasq() {
  /etc/init.d/dnsmasq reload
}

start_service() {
  _info "start shadowproxy service."
  if [ -z "$(command -v /usr/bin/sslocal)" ]; then
    _error "/usr/bin/sslocal is not exist, please install it."
    return 1
  fi

  generate_config_json

  if [ "${ENABLED}" = "0" ]; then
    _info "service shadowproxy not enabled"
    return 0
  fi

  if [ -z "${SERVER_LIST_STR}" ]; then
    _info "no enabled server, exit"
    return 1
  fi

  config_sysctl
  config_route
  update_nftables
  start_shadowproxy
  # sslocal has to be up before dnsmasq starts forwarding the listed domains
  update_dnsmasq_rules
  reload_dnsmasq
}

stop_service() {
  _info "stop shadowproxy service."

  remove_dnsmasq_rules
  reload_dnsmasq

  if [ -n "$(nft list tables | grep shadowproxy-mangle)" ]; then
    nft delete table inet shadowproxy-mangle
  fi
}

service_triggers() {
  procd_add_reload_trigger "shadowproxy"
}

reload_service() {
  stop
  start
}
