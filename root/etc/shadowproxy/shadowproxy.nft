
define whitelist_v4 = {
    0.0.0.0/8,
    10.0.0.0/8,
    100.64.0.0/10,
    127.0.0.0/8,
    169.254.0.0/16,
    172.16.0.0/12,
    192.0.0.0/24,
    192.0.2.0/24,
    192.88.99.0/24,
    198.18.0.0/15,
    192.168.0.0/16,
    198.51.100.0/24,
    203.0.113.0/24,
    224.0.0.0/4,
    240.0.0.0/4,
}

define whitelist_v6 = {
    ::/128,
    ::1/128,
    ::ffff:0:0/96,
    ::ffff:0:0:0/96,
    64:ff9b::/96,
    100::/64,
    2001::/32,
    2001:20::/28,
    2001:db8::/32,
    2002::/16,
    fc00::/7,
    fe80::/10,
    ff00::/8,
}

define tproxy_port = 60080

table inet shadowproxy-mangle {
    set whitelist_v4_set {
        type ipv4_addr
        flags interval
        elements=$whitelist_v4
    }

    set whitelist_v6_set {
        type ipv6_addr
        flags interval
        elements=$whitelist_v6
    }

    # Addresses resolved for the domains listed in the LuCI page. dnsmasq
    # fills them in via --nftset, so only traffic to those domains is
    # proxied. The trailing 4/6 in the name tells dnsmasq which address
    # family the set holds.
    # Addresses resolved for the domains listed in the LuCI page. dnsmasq
    # fills them in via --nftset, so only traffic to those domains is
    # proxied. The trailing 4/6 in the name tells dnsmasq which address
    # family the set holds.
    set proxy_set4 {
        type ipv4_addr
        flags interval
    }

    set proxy_set6 {
        type ipv6_addr
        flags interval
    }

    # Addresses resolved for bypass_domain. dnsmasq fills them in via
    # --nftset, so traffic to those domains bypasses the proxy tunnel.
    set bypass_set4 {
        type ipv4_addr
        flags interval
    }

    set bypass_set6 {
        type ipv6_addr
        flags interval
    }

    chain shadowproxy_input {
        type filter hook prerouting priority mangle; policy accept;
        ct state established,related return comment "fast path for existing conns"
        meta mark 255 return comment "bypass sslocal fwmark 255"
        ip daddr @whitelist_v4_set return comment "bypass whitelist_v4"
        ip6 daddr @whitelist_v6_set return comment "bypass whitelist_v6"
        ip daddr @bypass_set4 return comment "bypass bypass_set4"
        ip6 daddr @bypass_set6 return comment "bypass bypass_set6"
        ip daddr @proxy_set4 meta l4proto tcp meta mark set 255 tproxy ip to :$tproxy_port log prefix "shadowproxy: tcp " accept
        ip6 daddr @proxy_set6 meta l4proto tcp meta mark set 255 tproxy ip6 to :$tproxy_port log prefix "shadowproxy: tcp6 " accept
        ip daddr @proxy_set4 meta l4proto udp meta mark set 255 tproxy ip to :$tproxy_port log prefix "shadowproxy: udp " accept
        ip6 daddr @proxy_set6 meta l4proto udp meta mark set 255 tproxy ip6 to :$tproxy_port log prefix "shadowproxy: udp6 " accept
    }

    chain shadowproxy_output {
        type route hook output priority mangle; policy accept;
        meta l4proto tcp ct direction reply return comment "tcp conntrack"
        meta mark 255 return comment "bypass sslocal fwmark 255"
        ip daddr @whitelist_v4_set return comment "bypass whitelist_v4"
        ip6 daddr @whitelist_v6_set return comment "bypass whitelist_v6"
        ip daddr @bypass_set4 return comment "bypass bypass_set4"
        ip6 daddr @bypass_set6 return comment "bypass bypass_set6"
        ip daddr @proxy_set4 meta l4proto tcp meta mark set 255 accept log prefix "shadowproxy: out tcp "
        ip6 daddr @proxy_set6 meta l4proto tcp meta mark set 255 accept log prefix "shadowproxy: out tcp6 "
        ip daddr @proxy_set4 meta l4proto udp meta mark set 255 accept log prefix "shadowproxy: out udp "
        ip6 daddr @proxy_set6 meta l4proto udp meta mark set 255 accept log prefix "shadowproxy: out udp6 "
    }

}
