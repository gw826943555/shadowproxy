{
  "luci-app-shadowsocks-rust": {
    "description": "Grant access to shadowsocks-rust TProxy",
    "read": {
      "ubus": {
        "uci": [ "get", "changes" ],
        "service": [ "list" ],
        "log": [ "read" ]
      },
      "uci": ["shadowsocks-rust"]
    },
    "write": {
      "ubus": {
        "uci": [ "add", "set", "delete", "order", "commit", "apply", "confirm" ]
      },
      "uci": ["shadowsocks-rust"]
    }
  }
}
