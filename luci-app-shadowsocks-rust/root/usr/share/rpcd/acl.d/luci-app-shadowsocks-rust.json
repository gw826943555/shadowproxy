{
  "luci-app-shadowsocks-rust": {
    "description": "Grant access to shadowsocks-rust TProxy",
    "read": {
      "ubus": {
        "uci": [ "get" ],
        "service": [ "list" ]
      },
      "file": {
        "/usr/bin/sslocal": [ "exec" ],
        "/etc/shadowproxy/*": ["read"]
      },
      "uci": ["shadowproxy"]
    },
    "write": {
      "ubus": {
        "uci": [ "set", "commit" ]
      },
      "file": {
        "/etc/shadowproxy/*": ["write"]
      },
      "uci": ["shadowproxy"]
    }
  }
}
